#!/bin/sh

echo "Running pre-commit hooks..."

# Run the auto numbering script
python scripts/auto_number.py

# Add UTM parameters if missing
python scripts/add_utm.py

# Run the JSON generation script
python scripts/generate_json.py

# Fetch Domain Ratings for new or outdated directories
python scripts/fetch_dr.py

# Stage the updated files
git add README.md launchdb.json

echo "Pre-commit hooks executed successfully."
